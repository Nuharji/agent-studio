{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Studio",
  "mainBinaryName": "agent-studio",
  "version": "1.7.0",
  "identifier": "com.agentstudio.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Studio",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Build apps with AI",
    "longDescription": "Build apps with Claude: every project has its own rights, to-do list, sessions, build / test commands and git changes. New apps are set up by Claude; you approve pushes and releases, see every step live and can stop it at any time. Uses Claude Code with your own sign-in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}